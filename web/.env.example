# Required in production (≥16 chars, not "ybs-admin-local").
# Without it, /api/admin/* returns 503 and admin UI cannot write.
ADMIN_TOKEN=

# Production: set true to show /admin editor (default false on VPS compose).
# ADMIN_UI_ENABLED=true

# Optional: absolute path to catalog + ybs_*.json (bind-mount on VPS).
# YBS_DATA_ROOT=/repo

# Optional overrides
# NODE_ENV=production
